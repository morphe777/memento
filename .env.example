# Copier en .env et adapter. Ne jamais versionner .env.
MEMENTO_DB_FILE=./data/memento.db
MEMENTO_HOST=127.0.0.1
MEMENTO_API_PORT=4500
MEMENTO_WEB_DEV_PORT=4501
MEMENTO_MCP_PORT=4502
# true derrière HTTPS (NPM). false en dev http.
MEMENTO_COOKIE_SECURE=false
TZ=Europe/Paris
# MCP : jeton IA créé via `pnpm token:create`
MEMENTO_API_URL=http://127.0.0.1:4500/api/v1
MEMENTO_MCP_TOKEN=
