# Copier en .env et adapter. Ne jamais versionner .env.
MEMENTO_DB_FILE=./data/memento.db
MEMENTO_HOST=127.0.0.1
MEMENTO_API_PORT=4500
MEMENTO_WEB_DEV_PORT=4501
MEMENTO_MCP_PORT=4502
MEMENTO_MCP_HOST=127.0.0.1
# true derrière HTTPS (NPM). false en dev http.
MEMENTO_COOKIE_SECURE=false
# IP ou CIDR du reverse proxy (X-Forwarded-For cru seulement de lui). Vide en dev.
MEMENTO_TRUST_PROXY=
TZ=Europe/Paris
# MCP : adresse de l'API. Le serveur MCP ne garde aucun jeton : chaque agent envoie le sien (Authorization: Bearer).
MEMENTO_API_URL=http://127.0.0.1:4500/api/v1
# Facultatif : valeurs par défaut si rien n'est saisi dans Configuration (IA, Notifications). Jamais dans le dépôt.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# MEMENTO_AI_API_KEY=
# MEMENTO_TELEGRAM_BOT_TOKEN=
