{
  "name": "memento",
  "version": "1.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @memento/api --filter @memento/web dev",
    "build": "pnpm --filter @memento/web build",
    "start": "pnpm --filter @memento/api start",
    "worker": "pnpm --filter @memento/worker start",
    "mcp": "pnpm --filter @memento/mcp start",
    "db:generate": "pnpm --filter @memento/db generate",
    "db:migrate": "pnpm --filter @memento/db migrate",
    "db:backup": "pnpm --filter @memento/db backup",
    "db:verify": "pnpm --filter @memento/db verify",
    "db:seed": "pnpm --filter @memento/domain seed",
    "db:demo": "pnpm --filter @memento/domain demo",
    "db:check": "pnpm --filter @memento/domain check-data",
    "user:set-password": "pnpm --filter @memento/api user:set-password",
    "token:create": "pnpm --filter @memento/api token:create",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:dates": "MEMENTO_TEST_NOW=2027-01-01T00:00:00Z vitest run --sequence.shuffle && MEMENTO_TEST_NOW=2026-11-30T23:30:00Z vitest run --sequence.shuffle",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "db:demo-map": "pnpm --filter @memento/domain demo-map"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
